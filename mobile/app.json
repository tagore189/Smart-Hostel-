{
  "expo": {
    "name": "SLG Luxury Ladies PG",
    "slug": "slg-luxury-ladies-pg",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "slghostel",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#7C3AED"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.slgluxury.ladiespg"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7C3AED"
      },
      "package": "com.slgluxury.ladiespg",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CALL_PHONE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SLG Luxury PG to access photos to attach photos to maintenance tickets.",
          "cameraPermission": "Allow SLG Luxury PG to take photos for maintenance complaints."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow SLG Luxury PG to share your coordinates when you explicitly trigger the emergency SOS welfare alert."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8b5f3a09-1234-5678-abcd-slgluxurypg"
      }
    }
  }
}
